# ======================================================
# State Identification Module — Environment Variables
# ======================================================

# ------ HuggingFace Configuration ------
HF_TOKEN=your_huggingface_token

# ------ Backend Server Configuration ------
BACKEND_PORT=8000
FLASK_ENV=development

# ------ MongoDB Configuration ------
# Free MongoDB Atlas cluster setup instructions:
#   1. Go to https://www.mongodb.com/atlas and create a free account
#   2. Create a free M0 cluster (shared, 512MB, free forever)
#   3. Set up a database user:
#      - Go to Database Access → Add New Database User
#      - Choose "Password" auth, create username & password
#   4. Set up network access:
#      - Go to Network Access → Add IP Address
#      - Add 0.0.0.0/0 for development (or your specific IP)
#   5. Get connection string:
#      - Go to Database → Connect → Drivers → Python
#      - Copy the connection string and replace <password> with your password
#      - The database name "state_management" will be created automatically
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/state_management?retryWrites=true&w=majority

# ------ JWT Authentication ------
# Generate a strong random secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-key-here
JWT_EXPIRY_HOURS=72

# ------ Google OAuth ------
# Setup instructions:
#   1. Go to https://console.cloud.google.com
#   2. Create a new project (or select existing)
#   3. Go to "APIs & Services" → "Credentials"
#   4. Click "Create Credentials" → "OAuth 2.0 Client ID"
#   5. Application type: "Web application"
#   6. Add Authorized JavaScript origins:
#      - http://localhost:5173 (Vite dev server)
#      - http://localhost:3000
#   7. Add Authorized redirect URIs:
#      - http://localhost:5173
#   8. Copy the Client ID below
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com